

# === Database ===

# These variables are special, since they are consumed
# by both keystone and postgres docker image.
# Cannot be renamed if you use postgres in docker.
# See: https://hub.docker.com/_/postgres

POSTGRES_DB=im_app

POSTGRES_USER=im_app
POSTGRES_PASSWORD=im_app
DB_HOST=localhost
DB_PORT=5432
GOOGLE_MAPS_API_KEY=#############

S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


ALLOW_ORIGINS=

ENVIROMENT=DEV

FRONTEND_URL=

#Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# SMTP (correos transaccionales)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Kadesh
SMTP_ADMIN_NOTIFICATION_EMAILS=

# Mailtrap Send API (correos transaccionales, HTTPS — recomendado en Railway)
MAILTRAP_API_TOKEN=
# Alternativa: reutiliza SMTP_PASS si ya tienes el API token ahí

# === IA (Cerebro Kadesh) ===
# 32 bytes en hex: openssl rand -hex 32
AI_ENCRYPTION_KEY=
# Modalidad administrada: proveedor y key de la plataforma (nunca se exponen al frontend)
PLATFORM_AI_PROVIDER=anthropic
PLATFORM_AI_API_KEY=
# Override opcional del modelo de plataforma; vacío = default del proveedor.
# Con Gemini managed se recorre MANAGED_GEMINI_FALLBACK si ese modelo se agota.
PLATFORM_AI_MODEL=

# === INEGI (DENUE + Banco de Indicadores) ===
# Tokens gratuitos: registro en inegi.org.mx (son independientes entre sí).
# No se validan al arrancar Keystone; fallan en la mutación/script si faltan.
INEGI_DENUE_TOKEN=
INEGI_INDICADORES_TOKEN=
