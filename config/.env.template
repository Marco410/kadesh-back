

# === Database ===

# These variables are special, since they are consumed
# by both keystone and postgres docker image.
# Cannot be renamed if you use postgres in docker.
# See: https://hub.docker.com/_/postgres

POSTGRES_DB=im_app

POSTGRES_USER=im_app
POSTGRES_PASSWORD=im_app
DB_HOST=localhost
DB_PORT=5432
GOOGLE_MAPS_API_KEY=#############

# Object storage: Cloudflare R2 (S3-compatible). Same var names as AWS S3.
# Token: R2 → Manage R2 API Tokens → Object Read & Write (bucket-scoped).
# Endpoint must NOT include the bucket name.
S3_BUCKET_NAME=
S3_REGION=auto
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


ALLOW_ORIGINS=

ENVIROMENT=DEV

FRONTEND_URL=
# URL de cada front para los correos del blog (PET cae a FRONTEND_URL si está vacía)
PET_FRONTEND_URL=
SAAS_FRONTEND_URL=

#Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# SMTP (correos transaccionales)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Kadesh
SMTP_ADMIN_NOTIFICATION_EMAILS=

# Mailtrap Send API (correos transaccionales, HTTPS — recomendado en Railway)
MAILTRAP_API_TOKEN=
# Alternativa: reutiliza SMTP_PASS si ya tienes el API token ahí

# === IA (Cerebro Kadesh) ===
# 32 bytes en hex: openssl rand -hex 32
AI_ENCRYPTION_KEY=
# Modalidad administrada: proveedor y key de la plataforma (nunca se exponen al frontend)
PLATFORM_AI_PROVIDER=anthropic
PLATFORM_AI_API_KEY=
# Override opcional del modelo de plataforma; vacío = default del proveedor.
# Con Gemini managed se recorre MANAGED_GEMINI_FALLBACK si ese modelo se agota.
PLATFORM_AI_MODEL=

# === INEGI (DENUE + Banco de Indicadores) ===
# Tokens gratuitos: registro en inegi.org.mx (son independientes entre sí).
# No se validan al arrancar Keystone; fallan en la mutación/script si faltan.
INEGI_DENUE_TOKEN=
INEGI_INDICADORES_TOKEN=

# === Cron externo (GitHub Actions) ===
# Autoriza la mutación publishScheduledPosts (correo de posts programados). Genera uno random:
# openssl rand -hex 32 — y ponlo igual en Railway y en el secret CRON_SECRET de GitHub Actions.
CRON_SECRET=

# Autoriza la mutación upsertDraftSystemRelease, llamada desde el CI de kadesh-landing y
# kadesh-business (push a main) para armar el borrador de novedades. Genera uno random:
# openssl rand -hex 32 — y ponlo igual en Railway y en el secret SYSTEM_RELEASE_SECRET de
# GitHub Actions en AMBOS repos (kadesh-landing y kadesh-business).
SYSTEM_RELEASE_SECRET=

# === Facebook (Graph API) — publicar posts del blog en la Página de cada producto ===
# Requiere una App de Meta for Developers + un token de PÁGINA (no de usuario) con
# pages_manage_posts. Sin esto, simplemente no publica (no rompe el guardado del post).
FACEBOOK_GRAPH_API_VERSION=v21.0
FACEBOOK_PET_PAGE_ID=
FACEBOOK_PET_PAGE_ACCESS_TOKEN=
FACEBOOK_SAAS_PAGE_ID=
FACEBOOK_SAAS_PAGE_ACCESS_TOKEN=

# === WhatsApp Business (Cloud API) — conectado por SaasCompany, BYOK ===
# Cada empresa trae su propia App de Meta (WABA, número, token, app secret — eso se guarda
# cifrado en SaasCompany, no aquí). Este valor es el único global: el "Verify Token" del
# handshake inicial del webhook. Genera uno random (openssl rand -hex 20) y dáselo a cada
# empresa para que lo pongan igual al configurar el webhook de SU App. No es secreto de alto
# riesgo — la seguridad real la da la firma X-Hub-Signature-256, verificada con el App Secret
# de cada empresa. Nunca lo pongas literal en el código del front — se sirve al front
# autenticado vía companyWhatsappWebhookInfo (graphql/customs/queries/whatsapp), gateado por
# canManageCompanyWhatsapp.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Dominio público de este backend (Railway), sin slash final y sin la ruta (aunque si la pones se ignora) — de aquí sale la Callback URL
# del webhook (<WHATSAPP_WEBHOOK_BASE_URL>/webhooks/whatsapp) que companyWhatsappWebhookInfo
# le da al front. Ej. https://kadesh-back-production.up.railway.app
WHATSAPP_WEBHOOK_BASE_URL=
