{
  "name": "keystone-app",
  "version": "1.0.2",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "migrate": "keystone prisma migrate dev",
    "migration:status": "keystone prisma migrate status",
    "dev": "keystone dev",
    "start": "keystone start",
    "build": "keystone build",
    "postinstall": "keystone build --no-ui",
    "db:seed": "cross-env IS_BUILDING=true tsx seed.ts",
    "inegi:import:denue": "cross-env IS_BUILDING=true tsx inegi-denue-import.ts",
    "inegi:import:indicadores": "cross-env IS_BUILDING=true tsx inegi-indicadores-import.ts",
    "inegi:import:geo": "cross-env IS_BUILDING=true tsx inegi-geo-import.ts"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.23",
    "@keystone-6/auth": "^8.0.0",
    "@keystone-6/core": "^6.0.0",
    "@keystone-6/fields-document": "^9.0.0",
    "@prisma/client": "5.22.0",
    "@types/jsonwebtoken": "^9.0.9",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.2.35",
    "nodemailer": "^8.0.9",
    "slate-dom": "^0.111.0",
    "stripe": "^20.4.0",
    "csv-parse": "^7.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "prisma": "5.22.0"
  }
}
